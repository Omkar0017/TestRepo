package com.example.kafkaconsumer.listener;

import com.example.kafkaconsumer.config.ClusterConfig;
import com.example.kafkaconsumer.config.TopicConfig;
import org.apache.kafka.common.header.Headers;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.kafka.annotation.KafkaListener;
import org.springframework.kafka.support.Acknowledgment;
import org.springframework.kafka.support.KafkaHeaders;
import org.springframework.stereotype.Component;

import java.util.List;

@Component
public class KafkaListeners {

  @Autowired
  private List<ClusterConfig> clusters;

  @KafkaListener(
      topics = "#{'${kafka.clusters[0].topics.string-topics.*.topicName}'.split(',')}",
      containerFactory = "cluster1-string"
  )
  public void listenCluster1String(String message, @Header(KafkaHeaders.RECEIVED_TOPIC) String topic, Acknowledgment ack) {
    String application = getApplicationByTopic(topic, "cluster1", "string");
    System.out.println("Received message in cluster 1: " + message + " from topic: " + topic + " for application: " + application);
    ack.acknowledge();
  }

  @KafkaListener(
      topics = "#{'${kafka.clusters[0].topics.avro-topics.*.topicName}'.split(',')}",
      containerFactory = "cluster1-avro"
  )
  public void listenCluster1Avro(String message, @Header(KafkaHeaders.RECEIVED_TOPIC) String topic, Acknowledgment ack) {
    String application = getApplicationByTopic(topic, "cluster1", "avro");
    System.out.println("Received message in cluster 1: " + message + " from topic: " + topic + " for application: " + application);
    ack.acknowledge();
  }

  @KafkaListener(
      topics = "#{'${kafka.clusters[1].topics.string-topics.*.topicName}'.split(',')}",
      containerFactory = "cluster2-string"
  )
  public void listenCluster2String(String message, @Header(KafkaHeaders.RECEIVED_TOPIC) String topic, Acknowledgment ack) {
    String application = getApplicationByTopic(topic, "cluster2", "string");
    System.out.println("Received message in cluster 2: " + message + " from topic: " + topic + " for application: " + application);
    ack.acknowledge();
  }

  @KafkaListener(
      topics = "#{'${kafka.clusters[1].topics.avro-topics.*.topicName}'.split(',')}",
      containerFactory = "cluster2-avro"
  )
  public void listenCluster2Avro(String message, @Header(KafkaHeaders.RECEIVED_TOPIC) String topic, Acknowledgment ack) {
    String application = getApplicationByTopic(topic, "cluster2", "avro");
    System.out.println("Received message in cluster 2: " + message + " from topic: " + topic + " for application: " + application);
    ack.acknowledge();
  }

  private String getApplicationByTopic(String topic, String clusterName, String serde) {
    for (ClusterConfig cluster : clusters) {
      if (cluster.getName().equals(clusterName)) {
        List<TopicConfig> topics = "string".equals(serde) ? cluster.getStringTopics() : cluster.getAvroTopics();
        for (TopicConfig topicConfig : topics) {
          if (topicConfig.getTopicName().equals(topic)) {
            return topicConfig.getApplication();
          }
        }
      }
    }
    return "Unknown";
  }
}
